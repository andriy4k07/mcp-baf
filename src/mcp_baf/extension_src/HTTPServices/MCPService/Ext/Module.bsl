// ── Вспомогательные функции ──────────────────────────────────

Функция РазобратьJSON(СтрокаJSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Результат;
КонецФункции

// Гард «только SELECT» — единое место правды для /query и /validate-query.
// Повторяет Python-проверку query_keyword: комментарии (// до конца строки и
// /* ... */) пропускаются в любом месте до первого слова, слово — буквы/цифры/«_»
// (BSL без регулярок, поэтому сканируем символы): «ВЫБРАТЬ/*x*/Т.Поле», «SELECT*»,
// «ВЫБРАТЬ<Таб>Поле» проходят так же, как на стороне клиента.
Функция ЭтоВыборка(ТекстЗапроса)
    Длина = СтрДлина(ТекстЗапроса);
    Позиция = 1;
    // Пропуск пробелов и комментариев перед первым словом
    Пока Позиция <= Длина Цикл
        Пара = Сред(ТекстЗапроса, Позиция, 2);
        Если Пара = "//" Тогда
            Конец = СтрНайти(ТекстЗапроса, Символы.ПС, НаправлениеПоиска.СНачала, Позиция);
            Если Конец = 0 Тогда
                Возврат Ложь;
            КонецЕсли;
            Позиция = Конец + 1;
        ИначеЕсли Пара = "/*" Тогда
            Конец = СтрНайти(ТекстЗапроса, "*/", НаправлениеПоиска.СНачала, Позиция + 2);
            Если Конец = 0 Тогда
                Возврат Ложь;
            КонецЕсли;
            Позиция = Конец + 2;
        ИначеЕсли ПустаяСтрока(Сред(ТекстЗапроса, Позиция, 1)) Тогда
            Позиция = Позиция + 1;
        Иначе
            Прервать;
        КонецЕсли;
    КонецЦикла;

    ПервоеСлово = "";
    Пока Позиция <= Длина Цикл
        Символ = Сред(ТекстЗапроса, Позиция, 1);
        ЭтоБуква = (ВРег(Символ) <> НРег(Символ)) ИЛИ Символ = "_";
        Если НЕ ЭтоБуква И (ПустаяСтрока(ПервоеСлово) ИЛИ СтрНайти("0123456789", Символ) = 0) Тогда
            Прервать;
        КонецЕсли;
        ПервоеСлово = ПервоеСлово + Символ;
        Позиция = Позиция + 1;
    КонецЦикла;

    Возврат ВРег(ПервоеСлово) = "ВЫБРАТЬ" ИЛИ ВРег(ПервоеСлово) = "SELECT";
КонецФункции

Функция ПохожеНаДатуISO(Значение)
    // Признак ISO-строки: «ГГГГ-ММ-ДД» или «ГГГГ-ММ-ДДTчч:мм:сс…». Хвост
    // (Z, ±чч:мм, дробные секунды) допускается — его разбирает РазобратьСтрокуДатыISO.
    Длина = СтрДлина(Значение);
    РазделителиДаты = (Сред(Значение, 5, 1) = "-") И (Сред(Значение, 8, 1) = "-");
    ЭтоДата = (Длина = 10) И РазделителиДаты;
    ЭтоДатаВремя = (Длина >= 19) И РазделителиДаты
        И (Сред(Значение, 11, 1) = "T" ИЛИ Сред(Значение, 11, 1) = " ")
        И (Сред(Значение, 14, 1) = ":") И (Сред(Значение, 17, 1) = ":");
    Возврат ЭтоДата ИЛИ ЭтоДатаВремя;
КонецФункции

Функция СмещениеСекундИзХвоста(Хвост)
    // Часовое смещение из хвоста ISO-строки: Z → 0, «+чч:мм»/«-чч:мм» → секунды,
    // хвост без зоны (только дробные секунды) → Неопределено (время уже локальное).
    ХвостБезПробелов = СокрЛП(Хвост);
    Если ПустаяСтрока(ХвостБезПробелов) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если Лев(ХвостБезПробелов, 1) = "." Тогда
        // Дробные секунды отбрасываем: «.123Z» → «Z», «.123» → ""
        Позиция = 2;
        Пока Позиция <= СтрДлина(ХвостБезПробелов) Цикл
            Символ = Сред(ХвостБезПробелов, Позиция, 1);
            Если Символ < "0" ИЛИ Символ > "9" Тогда
                Прервать;
            КонецЕсли;
            Позиция = Позиция + 1;
        КонецЦикла;
        ХвостБезПробелов = Сред(ХвостБезПробелов, Позиция);
        Если ПустаяСтрока(ХвостБезПробелов) Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;

    Если ВРег(ХвостБезПробелов) = "Z" Тогда
        Возврат 0;
    КонецЕсли;

    Знак = 1;
    Если Лев(ХвостБезПробелов, 1) = "-" Тогда
        Знак = -1;
    ИначеЕсли Лев(ХвостБезПробелов, 1) <> "+" Тогда
        ВызватьИсключение "Некорректное смещение часового пояса: " + Хвост;
    КонецЕсли;
    Части = СтрРазделить(Сред(ХвостБезПробелов, 2), ":");
    Если Части.Количество() <> 2 Тогда
        ВызватьИсключение "Некорректное смещение часового пояса: " + Хвост;
    КонецЕсли;
    Возврат Знак * (Число(Части[0]) * 3600 + Число(Части[1]) * 60);
КонецФункции

Функция РазобратьСтрокуДатыISO(Значение)
    // Единая нормализация ISO-строк для параметров запроса и фильтров журнала.
    // Дата со смещением (Z/±чч:мм) — абсолютный момент: переводим в местное
    // время сеанса. Без смещения строка трактуется как локальное время (как раньше).
    // Неопределено — строка не является корректной датой.
    СтрокаЗначение = СокрЛП(Значение);
    Длина = СтрДлина(СтрокаЗначение);
    Если Длина = 10 Тогда
        База = СтрокаЗначение + "T00:00:00";
        Хвост = "";
    Иначе
        База = СтрЗаменить(Лев(СтрокаЗначение, 19), " ", "T");
        Хвост = Сред(СтрокаЗначение, 20);
    КонецЕсли;

    Попытка
        ДатаБезЗоны = XMLЗначение(Тип("Дата"), База);
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Попытка
        СмещениеСекунд = СмещениеСекундИзХвоста(Хвост);
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если СмещениеСекунд = Неопределено Тогда
        Возврат ДатаБезЗоны;
    КонецЕсли;

    Возврат МестноеВремя(ДатаБезЗоны - СмещениеСекунд, ЧасовойПоясСеанса());
КонецФункции

Функция ПреобразоватьЗначениеПараметра(Знач Значение)
    // Значения query-параметров приходят из JSON строками. Если строка имеет ISO-формат
    // даты ("ГГГГ-ММ-ДД" или "ГГГГ-ММ-ДДTчч:мм:сс"), приводим её к типу Дата — иначе
    // виртуальные таблицы (.Остатки(&Дата, ...)) дают "Несоответствие типов (Параметр номер 1)".
    // Смещение часового пояса (Z, ±чч:мм) больше не отбрасывается: момент переводится
    // в местное время сеанса. Нестроковые значения и строки иного вида возвращаются
    // без изменений; некорректная дата — исключение (400 вместо тихой подстановки строки).
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Значение;
    КонецЕсли;

    Если НЕ ПохожеНаДатуISO(Значение) Тогда
        Возврат Значение;
    КонецЕсли;

    ДатаПараметра = РазобратьСтрокуДатыISO(Значение);
    Если ДатаПараметра = Неопределено Тогда
        ВызватьИсключение "Некорректная дата параметра: " + Значение;
    КонецЕсли;
    Возврат ДатаПараметра;
КонецФункции

Функция СформироватьJSON(Значение)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ОтветJSON(Значение)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Значение));
    Возврат Ответ;
КонецФункции

// Код ошибки по умолчанию выводится из HTTP-статуса; конкретные случаи
// передают свой код явно, чтобы клиент не разбирал текст сообщения.
Функция КодОшибкиПоУмолчанию(КодСостояния)
    Если КодСостояния = 400 Тогда
        Возврат "bad_request";
    ИначеЕсли КодСостояния = 403 Тогда
        Возврат "access_denied";
    ИначеЕсли КодСостояния = 404 Тогда
        Возврат "not_found";
    ИначеЕсли КодСостояния = 500 Тогда
        Возврат "internal_error";
    КонецЕсли;
    Возврат "error";
КонецФункции

Функция НовыйИдентификаторЗапроса()
    Возврат Строка(Новый УникальныйИдентификатор());
КонецФункции

// Полный платформенный текст ошибки остаётся только в журнале регистрации:
// клиенту уходит стабильный error_code и короткий текст без путей модулей
// и номеров строк. Журнал может быть недоступен (выключен, нет прав) —
// это не должно ломать ответ, поэтому запись обёрнута в Попытку.
Процедура ЗаписатьОшибкуВЖурнал(КодОшибки, Контекст, Инфо, Уровень = Неопределено)
    Если Уровень = Неопределено Тогда
        Уровень = УровеньЖурналаРегистрации.Ошибка;
    КонецЕсли;
    Попытка
        ЗаписьЖурналаРегистрации("MCP.Ошибка", Уровень, , ,
            "code=" + КодОшибки + "; context=" + Контекст
            + "; detail=" + ПодробноеПредставлениеОшибки(Инфо));
    Исключение
        // Журнал недоступен — ответ клиенту всё равно уходит.
    КонецПопытки;
КонецПроцедуры

// Тело ошибки: стабильный error_code + request_id для корреляции с журналом
// регистрации. Тот же идентификатор уходит в заголовок X-Request-Id.
Функция ОтветОшибка(КодСостояния, ТекстОшибки, Причина = "", КодОшибки = "", ИдентификаторЗапроса = "")
    Если ПустаяСтрока(КодОшибки) Тогда
        КодОшибки = КодОшибкиПоУмолчанию(КодСостояния);
    КонецЕсли;
    Если ПустаяСтрока(ИдентификаторЗапроса) Тогда
        ИдентификаторЗапроса = НовыйИдентификаторЗапроса();
    КонецЕсли;
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("X-Request-Id", ИдентификаторЗапроса);
    Данные = Новый Структура("error,error_code,request_id", ТекстОшибки, КодОшибки, ИдентификаторЗапроса);
    Если НЕ ПустаяСтрока(Причина) Тогда
        Данные.Вставить("reason", Причина);
    КонецЕсли;
    Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Данные));
    Возврат Ответ;
КонецФункции

Функция НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта)
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("Catalog",                      Метаданные.Справочники);
    Соответствие.Вставить("Document",                     Метаданные.Документы);
    Соответствие.Вставить("Enum",                         Метаданные.Перечисления);
    Соответствие.Вставить("DataProcessor",                Метаданные.Обработки);
    Соответствие.Вставить("Report",                       Метаданные.Отчеты);
    Соответствие.Вставить("InformationRegister",          Метаданные.РегистрыСведений);
    Соответствие.Вставить("AccumulationRegister",         Метаданные.РегистрыНакопления);
    Соответствие.Вставить("AccountingRegister",           Метаданные.РегистрыБухгалтерии);
    Соответствие.Вставить("CalculationRegister",          Метаданные.РегистрыРасчета);
    Соответствие.Вставить("ChartOfAccounts",              Метаданные.ПланыСчетов);
    Соответствие.Вставить("ChartOfCharacteristicTypes",   Метаданные.ПланыВидовХарактеристик);
    Соответствие.Вставить("ChartOfCalculationTypes",      Метаданные.ПланыВидовРасчета);
    Соответствие.Вставить("ExchangePlan",                 Метаданные.ПланыОбмена);
    Соответствие.Вставить("BusinessProcess",              Метаданные.БизнесПроцессы);
    Соответствие.Вставить("Task",                         Метаданные.Задачи);
    // Константы есть в белом списке типов Python (METADATA_TYPES): без этой
    // строки /object/Constant/<Имя> отвечал 404 на существующую константу.
    Соответствие.Вставить("Constant",                     Метаданные.Константы);

    Коллекция = Соответствие[ТипОбъекта];
    Если Коллекция = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Коллекция.Найти(ИмяОбъекта);
КонецФункции

Функция ЕстьКоллекция(ОбъектМД, ИмяКоллекции)
    Попытка
        Значение = ОбъектМД[ИмяКоллекции];
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// Структурированное описание типа реквизита. Строка(Тип) теряет имена объектов
// (СправочникСсылка.Номенклатура → «СправочникСсылка») и длину/точность,
// поэтому рядом с type отдаются type_names, length, precision и scale.
Процедура ДобавитьОписаниеТипа(Описание, ТипОписания)
    Описание.Вставить("type", Строка(ТипОписания));

    ИменаТипов = Новый Массив;
    ТипыТипа = ТипОписания.Типы();
    Для Каждого Тип Из ТипыТипа Цикл
        ИмяТипа = "";
        Попытка
            ОписаниеМетаданных = Метаданные.НайтиПоТипу(Тип);
            Если ОписаниеМетаданных <> Неопределено Тогда
                ИмяТипа = ОписаниеМетаданных.ПолноеИмя();
            КонецЕсли;
        Исключение
            ИмяТипа = "";
        КонецПопытки;
        Если ПустаяСтрока(ИмяТипа) Тогда
            ИмяТипа = Строка(Тип);
        КонецЕсли;
        ИменаТипов.Добавить(ИмяТипа);
    КонецЦикла;
    Описание.Вставить("type_names", ИменаТипов);

    Если ТипыТипа.Количество() = 1 Тогда
        Если ТипыТипа[0] = Тип("Строка") Тогда
            Описание.Вставить("length", ТипОписания.ДлинаСтроки);
        ИначеЕсли ТипыТипа[0] = Тип("Число") Тогда
            Описание.Вставить("precision", ТипОписания.Точность);
            Описание.Вставить("scale", ТипОписания.Масштаб);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Функция ПривестиЗначениеКJSON(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        // NULL отдаём как JSON null: клиент отличает «нет значения» от пустой строки.
        Возврат Неопределено;
    ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
        // ISO 8601 — тот же формат, что и в журнале регистрации (XMLСтрока).
        Возврат XMLСтрока(Значение);
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

Функция ПолучитьОсновнуюФорму(ОбъектМД)
    МассивОсновных = Новый Массив;
    МассивОсновных.Добавить("ОсновнаяФормаОбъекта");
    МассивОсновных.Добавить("ОсновнаяФормаСписка");
    МассивОсновных.Добавить("ОсновнаяФормаВыбора");
    МассивОсновных.Добавить("ОсновнаяФорма");

    Для Каждого ИмяСвойства Из МассивОсновных Цикл
        Попытка
            ОсновнаяФорма = ОбъектМД[ИмяСвойства];
            Если ОсновнаяФорма <> Неопределено Тогда
                Возврат ОсновнаяФорма;
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Попытка
        Если ОбъектМД.Формы.Количество() > 0 Тогда
            Для Каждого ФормаМД Из ОбъектМД.Формы Цикл
                Возврат ФормаМД;
            КонецЦикла;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

// Форма объекта по имени из query-параметра form; Неопределено — формы нет.
Функция НайтиФормуОбъекта(ОбъектМД, ИмяФормы)
    Попытка
        Если ОбъектМД.Формы.Количество() = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
        Возврат ОбъектМД.Формы.Найти(ИмяФормы);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// ── Обработчики HTTP-запросов ────────────────────────────────

// GET /metadata
Функция МетаданныеGET(Запрос)
    Если НЕ МетодДоступен("Метаданные", "GET") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Результат = Новый Структура;

    ИменаКоллекций = Новый Массив;
    ИменаКоллекций.Добавить("Справочники");
    ИменаКоллекций.Добавить("Документы");
    ИменаКоллекций.Добавить("Перечисления");
    ИменаКоллекций.Добавить("Обработки");
    ИменаКоллекций.Добавить("Отчеты");
    ИменаКоллекций.Добавить("РегистрыСведений");
    ИменаКоллекций.Добавить("РегистрыНакопления");
    ИменаКоллекций.Добавить("РегистрыБухгалтерии");
    ИменаКоллекций.Добавить("РегистрыРасчета");
    ИменаКоллекций.Добавить("ПланыСчетов");
    ИменаКоллекций.Добавить("ПланыВидовХарактеристик");
    ИменаКоллекций.Добавить("ПланыВидовРасчета");
    ИменаКоллекций.Добавить("ПланыОбмена");
    ИменаКоллекций.Добавить("БизнесПроцессы");
    ИменаКоллекций.Добавить("Задачи");
    ИменаКоллекций.Добавить("ЖурналыДокументов");
    ИменаКоллекций.Добавить("Константы");
    ИменаКоллекций.Добавить("ОбщиеМодули");
    ИменаКоллекций.Добавить("ОбщиеФормы");
    ИменаКоллекций.Добавить("ОбщиеКоманды");
    ИменаКоллекций.Добавить("ОбщиеМакеты");
    ИменаКоллекций.Добавить("Роли");
    ИменаКоллекций.Добавить("Подсистемы");
    ИменаКоллекций.Добавить("РегулярныеЗадания");
    ИменаКоллекций.Добавить("ВебСервисы");
    ИменаКоллекций.Добавить("HTTPСервисы");

    // filter — одна коллекция вместо перебора всех 26: полный обход метаданных
    // на большой базе — это десятки тысяч имён на каждый «оглядовий» вызов.
    Фильтр = "";
    // ПараметрыЗапроса — ФиксированноеСоответствие: метода Свойство() у него нет.
    ЗначениеПараметра = Запрос.ПараметрыЗапроса.Получить("filter");
    Если ЗначениеПараметра <> Неопределено Тогда
        Фильтр = СокрЛП(ЗначениеПараметра);
    КонецЕсли;

    КоллекцииКВыгрузке = Новый Массив;
    Если ПустаяСтрока(Фильтр) Тогда
        КоллекцииКВыгрузке = ИменаКоллекций;
    Иначе
        Если ИменаКоллекций.Найти(Фильтр) = Неопределено Тогда
            Возврат ОтветОшибка(400, "filter: неизвестная коллекция метаданных: " + Фильтр);
        КонецЕсли;
        КоллекцииКВыгрузке.Добавить(Фильтр);
    КонецЕсли;

    Для Каждого ИмяКоллекции Из КоллекцииКВыгрузке Цикл
        Попытка
            Коллекция = Метаданные[ИмяКоллекции];
            Имена = Новый Массив;
            Для Каждого ОбъектМетаданных Из Коллекция Цикл
                Имена.Добавить(ОбъектМетаданных.Имя);
            КонецЦикла;
            Результат.Вставить(ИмяКоллекции, Имена);
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /object/{type}/{name}
Функция ОбъектGET(Запрос)
    Если НЕ МетодДоступен("Объект", "GET") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("name", ОбъектМД.Имя);
    Результат.Вставить("synonym", ОбъектМД.Синоним);

    // У константы нет реквизитов — её тип отдаём на верхнем уровне (type/type_names/...).
    Если Метаданные.Константы.Найти(ОбъектМД.Имя) = ОбъектМД Тогда
        ДобавитьОписаниеТипа(Результат, ОбъектМД.Тип);
    КонецЕсли;

    Реквизиты = Новый Массив;
    Если ЕстьКоллекция(ОбъектМД, "Реквизиты") Тогда
        Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
            ОписаниеРеквизита = Новый Структура;
            ОписаниеРеквизита.Вставить("name", Реквизит.Имя);
            ОписаниеРеквизита.Вставить("synonym", Реквизит.Синоним);
            ДобавитьОписаниеТипа(ОписаниеРеквизита, Реквизит.Тип);
            Реквизиты.Добавить(ОписаниеРеквизита);
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("attributes", Реквизиты);

    Если ЕстьКоллекция(ОбъектМД, "ТабличныеЧасти") Тогда
        ТЧ = Новый Массив;
        Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
            ОписаниеТЧ = Новый Структура;
            ОписаниеТЧ.Вставить("name", ТабличнаяЧасть.Имя);
            РеквизитыТЧ = Новый Массив;
            Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
                Описание = Новый Структура;
                Описание.Вставить("name", Реквизит.Имя);
                Описание.Вставить("synonym", Реквизит.Синоним);
                ДобавитьОписаниеТипа(Описание, Реквизит.Тип);
                РеквизитыТЧ.Добавить(Описание);
            КонецЦикла;
            ОписаниеТЧ.Вставить("attributes", РеквизитыТЧ);
            ТЧ.Добавить(ОписаниеТЧ);
        КонецЦикла;
        Результат.Вставить("tabularParts", ТЧ);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "Измерения") Тогда
        Измерения = Новый Массив;
        Для Каждого Измерение Из ОбъектМД.Измерения Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Измерение.Имя);
            Описание.Вставить("synonym", Измерение.Синоним);
            ДобавитьОписаниеТипа(Описание, Измерение.Тип);
            Измерения.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("dimensions", Измерения);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "Ресурсы") Тогда
        Ресурсы = Новый Массив;
        Для Каждого Ресурс Из ОбъектМД.Ресурсы Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Ресурс.Имя);
            Описание.Вставить("synonym", Ресурс.Синоним);
            ДобавитьОписаниеТипа(Описание, Ресурс.Тип);
            Ресурсы.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("resources", Ресурсы);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "ЗначенияПеречисления") Тогда
        Значения = Новый Массив;
        Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Значение.Имя);
            Описание.Вставить("synonym", Значение.Синоним);
            Описание.Вставить("comment", Значение.Комментарий);
            Значения.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("values", Значения);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /query
Функция ЗапросPOST(Запрос)
    Если НЕ МетодДоступен("Запрос", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        // Невалидный JSON — это ошибка входа (400), а не сбой сервиса (500).
        ЗаписатьОшибкуВЖурнал("invalid_json", "POST /query", ИнформацияОбОшибке(),
            УровеньЖурналаРегистрации.Предупреждение);
        Возврат ОтветОшибка(400, "invalid JSON body", "", "invalid_json");
    КонецПопытки;

    Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
        Возврат ОтветОшибка(400, "invalid JSON body: expected an object", "", "invalid_json");
    КонецЕсли;

    Если НЕ Параметры.Свойство("query") Тогда
        Возврат ОтветОшибка(400, "query is required", "", "missing_query");
    КонецЕсли;
    Если ТипЗнч(Параметры.query) <> Тип("Строка") Тогда
        Возврат ОтветОшибка(400, "query: expected a string", "", "invalid_query");
    КонецЕсли;

    ТекстЗапроса = Параметры.query;
    Лимит = 100;
    Если Параметры.Свойство("limit") И ТипЗнч(Параметры.limit) = Тип("Число") И Параметры.limit > 0 Тогда
        Лимит = Мин(Параметры.limit, 1000);
    КонецЕсли;

    // Пагинация: offset пропускает первые записи результата, чтобы можно было
    // читать выборки больше лимита страницами. Глубокий offset стоит полного
    // прохода результата, поэтому сверху — жёсткая граница.
    Смещение = 0;
    Если Параметры.Свойство("offset") И ТипЗнч(Параметры.offset) = Тип("Число") И Параметры.offset > 0 Тогда
        Смещение = Параметры.offset;
    КонецЕсли;
    Если Смещение > 10000 Тогда
        Возврат ОтветОшибка(400, "offset: не более 10000", "offset_too_large");
    КонецЕсли;
    СмещениеЗапрошено = Смещение;

    Если НЕ ЭтоВыборка(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "Only SELECT queries allowed");
    КонецЕсли;

    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);

        Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из Параметры.parameters Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;

        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        // Платформенный текст (синтаксис, имена полей, типы параметров) —
        // только в журнал регистрации; клиенту — стабильный код и подсказка.
        ЗаписатьОшибкуВЖурнал("invalid_query", "POST /query", ИнформацияОбОшибке(),
            УровеньЖурналаРегистрации.Предупреждение);
        Возврат ОтветОшибка(400, "query execution failed: check syntax, field names and parameter types", "", "invalid_query");
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;

    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Смещение > 0 Тогда
            Смещение = Смещение - 1;
            Продолжить;
        КонецЕсли;
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    // count — сколько строк вернулось в этой странице (размер страницы).
    Результат.Вставить("count", Счетчик);
    Результат.Вставить("offset", СмещениеЗапрошено);
    Результат.Вставить("truncated", Усечено);
    // total — сколько строк всего. Честно известно, только если результат
    // прочитан до конца; при truncated ключа нет (клиент не должен его выдумывать).
    Если НЕ Усечено Тогда
        Результат.Вставить("total", СмещениеЗапрошено + Счетчик);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /configuration
Функция КонфигурацияGET(Запрос)
    Если НЕ МетодДоступен("Конфигурация", "GET") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Результат = Новый Структура;
    Результат.Вставить("name",             Метаданные.Имя);
    Результат.Вставить("version",          Метаданные.Версия);
    Результат.Вставить("vendor",           Метаданные.Поставщик);
    СИ = Новый СистемнаяИнформация;
    Результат.Вставить("platform_version", СИ.ВерсияПриложения);

    РежимИБ = "";
    Попытка
        СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
        Если СтрНайти(ВРег(СтрокаСоединения), "FILE=") > 0 Тогда
            РежимИБ = "file";
        ИначеЕсли СтрНайти(ВРег(СтрокаСоединения), "SRVR=") > 0 Тогда
            РежимИБ = "server";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Результат.Вставить("mode", РежимИБ);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /version
Функция ВерсияGET(Запрос)
    // Версия расширения — тоже сведения о базе: маршрут подчиняется тому же
    // праву использования метода, что и остальные (право Версия.GET в роли).
    Если НЕ МетодДоступен("Версия", "GET") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Результат = Новый Структура;
    Результат.Вставить("version", "0.6.1");

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /form/{type}/{name}
Функция ФормаGET(Запрос)
    Если НЕ МетодДоступен("Форма", "GET") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    // form — имя конкретной формы объекта; без него отдаётся основная форма.
    // Раньше параметр молча игнорировался, и клиент получал структуру чужой формы.
    ИмяФормы = "";
    // ПараметрыЗапроса — ФиксированноеСоответствие: метода Свойство() у него нет.
    ЗначениеПараметра = Запрос.ПараметрыЗапроса.Получить("form");
    Если ЗначениеПараметра <> Неопределено Тогда
        ИмяФормы = СокрЛП(ЗначениеПараметра);
    КонецЕсли;

    Если ПустаяСтрока(ИмяФормы) Тогда
        Форма = ПолучитьОсновнуюФорму(ОбъектМД);
    Иначе
        Форма = НайтиФормуОбъекта(ОбъектМД, ИмяФормы);
    КонецЕсли;
    Если Форма = Неопределено Тогда
        Возврат ОтветОшибка(404, "Form not found");
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("name", Форма.Имя);
    Результат.Вставить("title", Форма.Синоним);

    // Элементы формы (могут быть недоступны в режиме Предприятия)
    Элементы = Новый Массив;
    Попытка
        Для Каждого Элемент Из Форма.Элементы Цикл
            ОписаниеЭлемента = Новый Структура;
            ОписаниеЭлемента.Вставить("name", Элемент.Имя);
            ОписаниеЭлемента.Вставить("type", Строка(ТипЗнч(Элемент)));
            Попытка
                ОписаниеЭлемента.Вставить("title", Элемент.Заголовок);
            Исключение
                ОписаниеЭлемента.Вставить("title", "");
            КонецПопытки;
            Попытка
                ОписаниеЭлемента.Вставить("dataPath", Строка(Элемент.ПутьКДанным));
            Исключение
                ОписаниеЭлемента.Вставить("dataPath", "");
            КонецПопытки;
            Элементы.Добавить(ОписаниеЭлемента);
        КонецЦикла;
    Исключение
    КонецПопытки;
    Результат.Вставить("elements", Элементы);

    // Команды формы (могут быть недоступны в режиме Предприятия)
    Команды = Новый Массив;
    Попытка
        Для Каждого Команда Из Форма.Команды Цикл
            ОписаниеКоманды = Новый Структура;
            ОписаниеКоманды.Вставить("name", Команда.Имя);
            ОписаниеКоманды.Вставить("action", Команда.Действие);
            Команды.Добавить(ОписаниеКоманды);
        КонецЦикла;
    Исключение
    КонецПопытки;
    Результат.Вставить("commands", Команды);

    // Обработчики событий формы
    Обработчики = Новый Массив;
    МассивСобытий = Новый Массив;
    МассивСобытий.Добавить("ПриОткрытии");
    МассивСобытий.Добавить("ПриСозданииНаСервере");
    МассивСобытий.Добавить("ПередЗаписью");
    МассивСобытий.Добавить("ПриЗаписиНаСервере");
    МассивСобытий.Добавить("ПослеЗаписиНаСервере");
    МассивСобытий.Добавить("ПередЗакрытием");
    МассивСобытий.Добавить("ОбработкаОповещения");
    МассивСобытий.Добавить("ОбработкаНавигационнойСсылки");
    МассивСобытий.Добавить("ОбработкаВыбора");

    Для Каждого ИмяСобытия Из МассивСобытий Цикл
        Попытка
            ИмяОбработчика = Форма[ИмяСобытия];
            Если Не ПустаяСтрока(ИмяОбработчика) Тогда
                ОписаниеОбработчика = Новый Структура;
                ОписаниеОбработчика.Вставить("event", ИмяСобытия);
                ОписаниеОбработчика.Вставить("handler", ИмяОбработчика);
                Обработчики.Добавить(ОписаниеОбработчика);
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;
    Результат.Вставить("handlers", Обработчики);

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /validate-query
Функция ПроверкаЗапросаPOST(Запрос)
    Если НЕ МетодДоступен("ПроверкаЗапроса", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        ЗаписатьОшибкуВЖурнал("invalid_json", "POST /validate-query", ИнформацияОбОшибке(),
            УровеньЖурналаРегистрации.Предупреждение);
        Возврат ОтветОшибка(400, "invalid JSON body", "", "invalid_json");
    КонецПопытки;

    Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
        Возврат ОтветОшибка(400, "invalid JSON body: expected an object", "", "invalid_json");
    КонецЕсли;

    Если НЕ Параметры.Свойство("query") Тогда
        Возврат ОтветОшибка(400, "query is required", "", "missing_query");
    КонецЕсли;
    Если ТипЗнч(Параметры.query) <> Тип("Строка") Тогда
        Возврат ОтветОшибка(400, "query: expected a string", "", "invalid_query");
    КонецЕсли;

    ТекстЗапроса = Параметры.query;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required", "", "missing_query");
    КонецЕсли;

    Ошибки = Новый Массив;

    // Тот же гард, что в /query: проверка не должна подтверждать запрос,
    // который execute_query отклонит. Ошибка — машинный код not_select.
    Если НЕ ЭтоВыборка(ТекстЗапроса) Тогда
        Ошибки.Добавить("not_select");
        Результат = Новый Структура;
        Результат.Вставить("valid", Ложь);
        Результат.Вставить("errors", Ошибки);
        Возврат ОтветJSON(Результат);
    КонецЕсли;

    Попытка
        СхемаЗапроса = Новый СхемаЗапроса;
        СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
        СхемаЗапроса.ПолучитьТекстЗапроса();

        Результат = Новый Структура;
        Результат.Вставить("valid", Истина);
        Результат.Вставить("errors", Ошибки);
    Исключение
        // Полный текст — в журнал регистрации, клиенту — короткое описание.
        ЗаписатьОшибкуВЖурнал("invalid_query", "POST /validate-query", ИнформацияОбОшибке(),
            УровеньЖурналаРегистрации.Предупреждение);
        Результат = Новый Структура;
        Результат.Вставить("valid", Ложь);
        Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Результат.Вставить("errors", Ошибки);
    КонецПопытки;

    Возврат ОтветJSON(Результат);
КонецФункции

// Разбор даты фильтра: ISO 8601, «ГГГГ-ММ-ДД» дополняется временем; Неопределено — формат неверен
Функция РазобратьДатуОтбора(Значение)
    // Нестроковый вход (число, массив) — тот же неверный формат, а не падение.
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    // Та же нормализация, что и у параметров запроса: «ГГГГ-ММ-ДД», «…Tчч:мм:сс»
    // и ISO со смещением (Z/±чч:мм) дают один и тот же результат.
    Возврат РазобратьСтрокуДатыISO(Значение);
КонецФункции

// POST /eventlog
Функция ЖурналРегистрацииPOST(Запрос)
    Если НЕ МетодДоступен("ЖурналРегистрации", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    // Пустое тело = пустые параметры (все значения по умолчанию); битый JSON — 400.
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
    Если ПустаяСтрока(ТелоЗапроса) Тогда
        Параметры = Новый Структура;
    Иначе
        Попытка
            Параметры = РазобратьJSON(ТелоЗапроса);
        Исключение
            ЗаписатьОшибкуВЖурнал("invalid_json", "POST /eventlog", ИнформацияОбОшибке(),
                УровеньЖурналаРегистрации.Предупреждение);
            Возврат ОтветОшибка(400, "invalid JSON body", "", "invalid_json");
        КонецПопытки;
    КонецЕсли;

    Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
        Возврат ОтветОшибка(400, "invalid JSON body: expected an object", "", "invalid_json");
    КонецЕсли;

    Отбор = Новый Структура;

    Если Параметры.Свойство("start_date") И ЗначениеЗаполнено(Параметры.start_date) Тогда
        ЗначениеДаты = РазобратьДатуОтбора(Параметры.start_date);
        Если ЗначениеДаты = Неопределено Тогда
            Возврат ОтветОшибка(400, "start_date: expected ISO 8601 date, e.g. 2026-03-01 or 2026-03-01T00:00:00");
        КонецЕсли;
        Отбор.Вставить("ДатаНачала", ЗначениеДаты);
    КонецЕсли;

    Если Параметры.Свойство("end_date") И ЗначениеЗаполнено(Параметры.end_date) Тогда
        ЗначениеДаты = РазобратьДатуОтбора(Параметры.end_date);
        Если ЗначениеДаты = Неопределено Тогда
            Возврат ОтветОшибка(400, "end_date: expected ISO 8601 date, e.g. 2026-03-01 or 2026-03-01T00:00:00");
        КонецЕсли;
        Отбор.Вставить("ДатаОкончания", ЗначениеДаты);
    КонецЕсли;

    Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
        СоответствиеУровней = Новый Соответствие;
        СоответствиеУровней.Вставить("Ошибка",        УровеньЖурналаРегистрации.Ошибка);
        СоответствиеУровней.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
        СоответствиеУровней.Вставить("Информация",     УровеньЖурналаРегистрации.Информация);
        СоответствиеУровней.Вставить("Примечание",     УровеньЖурналаРегистрации.Примечание);
        Уровень = СоответствиеУровней[Параметры.level];
        Если Уровень = Неопределено Тогда
            // Неизвестный level нельзя молча игнорировать: ответ выглядел бы
            // отфильтрованным, но содержал бы все уровни подряд.
            Возврат ОтветОшибка(400, "level: Ошибка, Предупреждение, Информация, Примечание");
        КонецЕсли;
        МассивУровней = Новый Массив;
        МассивУровней.Добавить(Уровень);
        Отбор.Вставить("Уровень", МассивУровней);
    КонецЕсли;

    Если Параметры.Свойство("user") И ЗначениеЗаполнено(Параметры.user) Тогда
        // Без проверки типа конкатенация в текст ошибки падала бы неперехваченным
        // исключением (500) на нестроковом user.
        Если ТипЗнч(Параметры.user) <> Тип("Строка") Тогда
            Возврат ОтветОшибка(400, "user: ожидается строка с именем пользователя", "", "invalid_user");
        КонецЕсли;
        Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
            Возврат ОтветОшибка(403, "user: фильтр по пользователю требует административных прав", "", "admin_rights_required");
        КонецЕсли;
        ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Параметры.user);
        Если ПользовательИБ = Неопределено Тогда
            Возврат ОтветОшибка(400, "user: пользователь не найден: " + Параметры.user, "", "user_not_found");
        КонецЕсли;
        МассивПользователей = Новый Массив;
        МассивПользователей.Добавить(ПользовательИБ);
        Отбор.Вставить("Пользователь", МассивПользователей);
    КонецЕсли;

    Лимит = 50;
    Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
        Если ТипЗнч(Параметры.limit) <> Тип("Число") ИЛИ Параметры.limit <= 0 Тогда
            Возврат ОтветОшибка(400, "limit: ожидается положительное число", "", "invalid_param");
        КонецЕсли;
        Лимит = Мин(Параметры.limit, 500);
    КонецЕсли;

    // Защита от OOM: если не указана дата начала, ограничиваем последними 7 днями
    Если НЕ Отбор.Свойство("ДатаНачала") Тогда
        Отбор.Вставить("ДатаНачала", ТекущаяДата() - 7 * 86400);
    КонецЕсли;

    // Шум платформы (транзакции, фоновые задания) по умолчанию скрываем
    ИсключатьСистемные = НЕ Параметры.Свойство("exclude_system") ИЛИ Параметры.exclude_system <> Ложь;
    ПрефиксыШума = Новый Массив;
    ПрефиксыШума.Добавить("_$Transaction$_");
    ПрефиксыШума.Добавить("_$Job$_");
    ПрефиксыШума.Добавить("_$Session$_.Authentication");
    ПрефиксыШума.Добавить("_$Session$_.Finish");

    // Фильтр шума применяется ПОСЛЕ выгрузки, поэтому окно выгрузки должно быть
    // кратно больше лимита: иначе из Лимит записей после отсева шума может не
    // остаться ни одной, и клиент получит пустой список при живом журнале.
    // При заданном Уровне окно тоже широкое — отбор по уровню не отменяет шум.
    КапВыгрузки = Лимит;
    Если ИсключатьСистемные Тогда
        КапВыгрузки = Мин(Лимит * 20, 10000);
    КонецЕсли;

    МассивСобытий = Новый Массив;
    ВсегоЗаписей = 0;
    // Добор: если окно обрезано, а после отсева шума событий меньше лимита,
    // выборка расширяется и повторяется (до потолка 10000 записей).
    Пока Истина Цикл
        ТаблицаЖурнала = Новый ТаблицаЗначений;
        // 4-й параметр — файл журнала, количество записей — 5-й (как в БСП).
        // Выгрузка требует прав на администрирование данных: отказ прав или
        // недоступный журнал не должен валить обработчик платформенным 500.
        Попытка
            ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, , , КапВыгрузки);
        Исключение
            ЗаписатьОшибкуВЖурнал("eventlog_unavailable", "POST /eventlog", ИнформацияОбОшибке());
            Возврат ОтветОшибка(500,
                "eventlog is unavailable: check data administration rights or event log settings",
                "", "eventlog_unavailable");
        КонецПопытки;

        ВсегоЗаписей = ТаблицаЖурнала.Количество();
        МассивСобытий.Очистить();
        Для Каждого Строка Из ТаблицаЖурнала Цикл
            Если МассивСобытий.Количество() >= Лимит Тогда
                Прервать;
            КонецЕсли;
            Если ИсключатьСистемные Тогда
                Шум = Ложь;
                Для Каждого Префикс Из ПрефиксыШума Цикл
                    Если СтрНачинаетсяС(Строка(Строка.Событие), Префикс) Тогда
                        Шум = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                Если Шум Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
            Событие = Новый Структура;
            Событие.Вставить("date",        XMLСтрока(Строка.Дата));
            Событие.Вставить("level",       Строка(Строка.Уровень));
            Событие.Вставить("event",       Строка(Строка.Событие));
            Событие.Вставить("user",        Строка(Строка.ИмяПользователя));
            Событие.Вставить("computer",    Строка(Строка.Компьютер));
            Событие.Вставить("metadata",    ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "МетаданныеПредставление"));
            Событие.Вставить("data",        ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ДанныеПредставление"));
            Событие.Вставить("comment",     ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "Комментарий"));
            Событие.Вставить("transaction", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ИдентификаторТранзакции"));
            МассивСобытий.Добавить(Событие);
        КонецЦикла;

        // Окно не обрезано — дальше в журнале записей нет; событий достаточно
        // или потолок выгрузки достигнут — расширять выборку бессмысленно.
        Если ВсегоЗаписей < КапВыгрузки
            ИЛИ МассивСобытий.Количество() >= Лимит
            ИЛИ КапВыгрузки >= 10000 Тогда
            Прервать;
        КонецЕсли;
        КапВыгрузки = Мин(КапВыгрузки * 4, 10000);
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("events", МассивСобытий);
    // total — сколько записей реально вернулось; found — сколько нашлось
    // в выгруженном окне журнала (оно само ограничено КапВыгрузки).
    Результат.Вставить("total",  МассивСобытий.Количество());
    Результат.Вставить("found",  ВсегоЗаписей);
    // Список неполный, если упёрлись в Лимит или окно выгрузки обрезано.
    Результат.Вставить("truncated", ВсегоЗаписей > МассивСобытий.Количество() ИЛИ ВсегоЗаписей >= КапВыгрузки);
    // Журнал непустой, но всё окно отфильтровано как системный шум: клиент
    // должен видеть причину пустого events, а не «записей не найдено».
    Результат.Вставить("filtered_empty", МассивСобытий.Количество() = 0 И ВсегоЗаписей > 0);

    Возврат ОтветJSON(Результат);
КонецФункции

Функция ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, ИмяКолонки)
    Если ТаблицаЖурнала.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Строка[ИмяКолонки]);
КонецФункции

// ── Эффективные права HTTP-пользователя ──────────────────────

Функция МетодДоступен(ИмяШаблона, ИмяМетода, ПричинаОтказа = "")
    // ПричинаОтказа — out-параметр: обнулять его на входе нельзя, иначе
    // причина отказа, переданная вызывающим кодом, теряется до первой ветки.
    // В привилегированном режиме результат проверки прав недостоверен.
    Если ПривилегированныйРежим() Тогда
        ПричинаОтказа = "privileged_mode";
        Возврат Ложь;
    КонецЕсли;
    Этап = "service";
    Попытка
        Сервис = Метаданные.HTTPСервисы.Найти("MCPService");
        Если Сервис = Неопределено Тогда
            ПричинаОтказа = "service_not_found";
            Возврат Ложь;
        КонецЕсли;
        Этап = "template";
        Шаблон = Сервис.ШаблоныURL.Найти(ИмяШаблона);
        Если Шаблон = Неопределено Тогда
            ПричинаОтказа = "template_not_found";
            Возврат Ложь;
        КонецЕсли;
        Этап = "method";
        Метод = Шаблон.Методы.Найти(ИмяМетода);
        Если Метод = Неопределено Тогда
            ПричинаОтказа = "method_not_found";
            Возврат Ложь;
        КонецЕсли;
        // Использование проверяется на точке вызова — методе HTTP-сервиса.
        // Сервис и шаблон URL только определяют его место в метаданных.
        Этап = "method_use";
        Если НЕ ПравоДоступа("Использование", Метод) Тогда
            ПричинаОтказа = "method_use_denied";
            Возврат Ложь;
        КонецЕсли;
        Возврат Истина;
    Исключение
        // Только этап технической проверки, без данных/ролей пользователя.
        ПричинаОтказа = "access_check_failed:" + Этап;
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция ВозможностиGET(Запрос)
    ПричинаОтказа = "";
    Если НЕ МетодДоступен("Возможности", "GET", ПричинаОтказа) Тогда
        Возврат ОтветОшибка(403, "Проверка прав HTTP-методов недоступна", ПричинаОтказа);
    КонецЕсли;
    Методы = Новый Массив;
    Карта = Новый Соответствие;
    Карта.Вставить("Метаданные", "metadata.GET");
    Карта.Вставить("Объект", "object.GET");
    Карта.Вставить("Форма", "form.GET");
    Карта.Вставить("Конфигурация", "configuration.GET");
    Карта.Вставить("Запрос", "query.POST");
    Карта.Вставить("ПроверкаЗапроса", "validate-query.POST");
    Карта.Вставить("ЖурналРегистрации", "eventlog.POST");
    Карта.Вставить("Ссылки", "refs.POST");
    Карта.Вставить("Навигация", "object-link.POST");
    Карта.Вставить("ПраваМетаданных", "metadata-rights.POST");
    Для Каждого Пара Из Карта Цикл
        Части = СтрРазделить(Пара.Значение, ".");
        Если МетодДоступен(Пара.Ключ, Части[1]) Тогда
            Методы.Добавить(Пара.Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат ОтветJSON(Новый Структура("methods", Методы));
КонецФункции

Функция ПроверитьИмяМетаданных(Имя)
    Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ ПустаяСтрока(Имя) Тогда
        ВызватьИсключение "Некорректное имя метаданных";
    КонецЕсли;
    Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяІЇЄҐіїєґ";
    Если СтрНайти(Буквы, Лев(Имя, 1)) = 0 Тогда
        ВызватьИсключение "Некорректное имя метаданных";
    КонецЕсли;
    ДопустимыеСимволы = Буквы + "0123456789";
    Для Индекс = 1 По СтрДлина(Имя) Цикл
        Если СтрНайти(ДопустимыеСимволы, Сред(Имя, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "Некорректное имя метаданных";
        КонецЕсли;
    КонецЦикла;
КонецФункции

Функция СсылкаИзGUID(Вид, GUID)
    Части = СтрРазделить(Вид, ".");
    Если Части.Количество() <> 2 Тогда
        ВызватьИсключение "Ожидается Тип.ИмяОбъекта";
    КонецЕсли;
    ПроверитьИмяМетаданных(Части[0]);
    ПроверитьИмяМетаданных(Части[1]);
    Виды = "Справочник,Документ,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача";
    Если СтрНайти("," + Виды + ",", "," + Части[0] + ",") = 0 Тогда
        ВызватьИсключение "Неподдерживаемый ссылочный тип метаданных";
    КонецЕсли;
    Мета = Метаданные.НайтиПоПолномуИмени(Вид);
    Если Мета = Неопределено Тогда
        ВызватьИсключение "Объект метаданных не найден";
    КонецЕсли;
    Если НЕ ПравоДоступа("Чтение", Мета) Тогда
        ВызватьИсключение "Нет права чтения объекта";
    КонецЕсли;
    Идентификатор = Новый УникальныйИдентификатор(GUID);
    Ссылка = XMLЗначение(Тип(Части[0] + "Ссылка." + Части[1]), Строка(Идентификатор));
    Если Ссылка.Пустая() Тогда
        ВызватьИсключение "Пустая ссылка не поддерживается";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Функция НавигацияPOST(Запрос)
    Если НЕ МетодДоступен("Навигация", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
        Если Параметры.mode <> "make" И Параметры.mode <> "resolve" Тогда
            Возврат ОтветОшибка(400, "mode: make, resolve");
        КонецЕсли;
        Ссылка = СсылкаИзGUID(Параметры.kind, Параметры.ref);
        // Проверка существования через запрос сохраняет ограничения RLS.
        Запрос1С = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Т.Ссылка ИЗ " + Параметры.kind + " КАК Т ГДЕ Т.Ссылка = &Цель");
        Запрос1С.УстановитьПараметр("Цель", Ссылка);
        Выборка = Запрос1С.Выполнить().Выбрать();
        Если НЕ Выборка.Следующий() Тогда
            Возврат ОтветJSON(Новый Структура("found", Ложь));
        КонецЕсли;
        Результат = Новый Структура("found,kind,ref,presentation,link", Истина,
            Параметры.kind, Строка(Ссылка.УникальныйИдентификатор()), Строка(Ссылка),
            ПолучитьНавигационнуюСсылку(Ссылка));
        Возврат ОтветJSON(Результат);
    Исключение
        Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции

// ── Поиск полей с ссылочным типом ────────────────────────────

Процедура ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, Таблица, Поле, ТипСсылки, ВидСовпадения)
    Путь = Таблица + "." + Поле.Имя;
    Попытка
        ПроверитьИмяМетаданных(Поле.Имя);
        Если НЕ Поле.Тип.СодержитТип(ТипСсылки) Тогда
            Возврат;
        КонецЕсли;
        // Права на поле проверяет сам запрос без привилегированного режима.
        // Проверка Чтение на вложенном объекте метаданных на старых платформах
        // может выбросить исключение и ошибочно исключить доступное поле.
        Кандидаты.Добавить(Новый Структура("table,field,path,match_kind", Таблица, Поле.Имя, Путь, ВидСовпадения));
    Исключение
        Пропуски.Добавить(Новый Структура("name,reason", Путь, "Проверка типа поля недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
    КонецПопытки;
КонецПроцедуры

Функция КлючиРегистра(Мета, Область)
    Ключи = Новый Массив;
    Если Область = "information_registers" Тогда
        Если Мета.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
            Ключи.Добавить("Период");
        КонецЕсли;
        Если Мета.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
            Ключи.Добавить("Регистратор");
            Ключи.Добавить("НомерСтроки");
        КонецЕсли;
    Иначе
        Ключи.Добавить("Регистратор");
        Ключи.Добавить("НомерСтроки");
        // У регистра расчёта поля Период нет.
        Ключи.Добавить(?(Область = "calculation_registers", "ПериодРегистрации", "Период"));
    КонецЕсли;
    Для Каждого Поле Из Мета.Измерения Цикл
        ПроверитьИмяМетаданных(Поле.Имя);
        // Все ключевые поля входят в SELECT РАЗРЕШЕННЫЕ; ошибка доступа
        // к любому из них исключает запрос целиком, а не ослабляет проверку.
        Ключи.Добавить(Поле.Имя);
    КонецЦикла;
    Возврат Ключи;
КонецФункции

Функция СсылкиPOST(Запрос)
    Если НЕ МетодДоступен("Ссылки", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Попытка
        П = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
        Цель = СсылкаИзGUID(П.ref_kind, П.ref);
        Если ТипЗнч(П.scope) <> Тип("Массив") ИЛИ П.scope.Количество() = 0 Тогда
            Возврат ОтветОшибка(400, "scope: catalogs, documents, information_registers, accumulation_registers, accounting_registers, calculation_registers, all");
        КонецЕсли;
        Если ТипЗнч(П.limit_hits) <> Тип("Число") ИЛИ П.limit_hits < 1 ИЛИ П.limit_hits > 1000
            ИЛИ ТипЗнч(П.limit_per_meta) <> Тип("Число") ИЛИ П.limit_per_meta < 1 ИЛИ П.limit_per_meta > 100
            ИЛИ ТипЗнч(П.timeout_budget_sec) <> Тип("Число") ИЛИ П.timeout_budget_sec < 1 ИЛИ П.timeout_budget_sec > 120 Тогда
            Возврат ОтветОшибка(400, "Лимиты: limit_hits 1..1000, limit_per_meta 1..100, timeout_budget_sec 1..120");
        КонецЕсли;
        Области = Новый Соответствие;
        Области.Вставить("catalogs", Новый Структура("collection,prefix", Метаданные.Справочники, "Справочник"));
        Области.Вставить("documents", Новый Структура("collection,prefix", Метаданные.Документы, "Документ"));
        Области.Вставить("information_registers", Новый Структура("collection,prefix", Метаданные.РегистрыСведений, "РегистрСведений"));
        Области.Вставить("accumulation_registers", Новый Структура("collection,prefix", Метаданные.РегистрыНакопления, "РегистрНакопления"));
        Области.Вставить("accounting_registers", Новый Структура("collection,prefix", Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии"));
        Области.Вставить("calculation_registers", Новый Структура("collection,prefix", Метаданные.РегистрыРасчета, "РегистрРасчета"));
        Для Каждого Область Из П.scope Цикл
            Если Область <> "all" И Области[Область] = Неопределено Тогда
                Возврат ОтветОшибка(400, "Неизвестный scope: допустимы catalogs, documents, information_registers, accumulation_registers, accounting_registers, calculation_registers, all");
            КонецЕсли;
        КонецЦикла;
        Найденные = Новый Массив;
        Пропуски = Новый Массив;
        Результат = Новый Структура("hits,skipped_names,timeout_exceeded,truncated", Найденные, Пропуски, Ложь, Ложь);
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Для Каждого О Из Области Цикл
            Если П.scope.Найти("all") = Неопределено И П.scope.Найти(О.Ключ) = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Для Каждого Мета Из О.Значение.collection Цикл
                Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало >= П.timeout_budget_sec * 1000 Тогда
                    Результат.timeout_exceeded = Истина;
                    Возврат ОтветJSON(Результат);
                КонецЕсли;
                Если Найденные.Количество() >= П.limit_hits Тогда
                    Результат.truncated = Истина;
                    Возврат ОтветJSON(Результат);
                КонецЕсли;
                ПолноеИмя = О.Значение.prefix + "." + Мета.Имя;
                Попытка
                    ПроверитьИмяМетаданных(Мета.Имя);
                    Если НЕ ПравоДоступа("Чтение", Мета) Тогда
                        Пропуски.Добавить(Новый Структура("name,reason", ПолноеИмя, "Нет права чтения"));
                        Продолжить;
                    КонецЕсли;
                    Кандидаты = Новый Массив;
                    ЭтоОбъект = О.Ключ = "catalogs" ИЛИ О.Ключ = "documents";
                    Для Каждого Поле Из Мета.Реквизиты Цикл
                        ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, ПолноеИмя, Поле, ТипЗнч(Цель), "attribute");
                    КонецЦикла;
                    Для Каждого Поле Из Мета.СтандартныеРеквизиты Цикл
                        // Ссылка объекта на самого себя — не использование.
                        Если Поле.Имя <> "Ссылка" И Поле.Имя <> "Ref" Тогда
                            ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, ПолноеИмя, Поле, ТипЗнч(Цель), "attribute");
                        КонецЕсли;
                    КонецЦикла;
                    Если ЭтоОбъект Тогда
                        Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
                            ПроверитьИмяМетаданных(ТЧ.Имя);
                            Для Каждого Поле Из ТЧ.Реквизиты Цикл
                                ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, ПолноеИмя + "." + ТЧ.Имя, Поле, ТипЗнч(Цель), "tabular_section");
                            КонецЦикла;
                        КонецЦикла;
                    Иначе
                        Для Каждого Поле Из Мета.Измерения Цикл
                            ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, ПолноеИмя, Поле, ТипЗнч(Цель), "register_dimension");
                        КонецЦикла;
                        Для Каждого Поле Из Мета.Ресурсы Цикл
                            ДобавитьПолеСсылки(Кандидаты, Пропуски, Мета, ПолноеИмя, Поле, ТипЗнч(Цель), "register_resource");
                        КонецЦикла;
                    КонецЕсли;
                    СчетчикМета = 0;
                    // Один запрос на таблицу вместо запроса на каждое поле (N+1).
                    // Кандидаты могут относиться к разным таблицам (реквизиты шапки
                    // и табличные части), поэтому сначала группируем по таблице.
                    ГруппыТаблиц = Новый Соответствие;
                    Для Каждого Кандидат Из Кандидаты Цикл
                        Группа = ГруппыТаблиц[Кандидат.table];
                        Если Группа = Неопределено Тогда
                            Группа = Новый Массив;
                            ГруппыТаблиц.Вставить(Кандидат.table, Группа);
                        КонецЕсли;
                        Группа.Добавить(Кандидат);
                    КонецЦикла;

                    Для Каждого ГруппаТаблицы Из ГруппыТаблиц Цикл
                        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало >= П.timeout_budget_sec * 1000 Тогда
                            Результат.timeout_exceeded = Истина;
                            Возврат ОтветJSON(Результат);
                        КонецЕсли;
                        ПоляКандидаты = ГруппаТаблицы.Значение;
                        ТаблицаКандидатов = ГруппаТаблицы.Ключ;
                        Осталось = Мин(П.limit_hits - Найденные.Количество(), П.limit_per_meta - СчетчикМета);
                        Если Осталось <= 0 Тогда
                            Результат.truncated = Истина;
                            Прервать;
                        КонецЕсли;
                        Попытка
                            Если ЭтоОбъект Тогда
                                Поля = "Т.Ссылка";
                                Ключи = Новый Массив;
                                Ключи.Добавить("Ссылка");
                            Иначе
                                Ключи = КлючиРегистра(Мета, О.Ключ);
                                Поля = "";
                                Для Каждого Ключ Из Ключи Цикл
                                    Если НЕ ПустаяСтрока(Поля) Тогда
                                        Поля = Поля + ", ";
                                    КонецЕсли;
                                    Поля = Поля + "Т." + Ключ;
                                КонецЦикла;
                                Если ПустаяСтрока(Поля) Тогда
                                    ВызватьИсключение "Ключи регистра недоступны";
                                КонецЕсли;
                            КонецЕсли;

                            // Условия объединяются через ИЛИ, а номер поля, которое
                            // совпало, вычисляется в самом запросе (ПолеСовпадения),
                            // чтобы не делать отдельный запрос на каждый реквизит.
                            Условия = "";
                            Маркеры = "ВЫБОР";
                            Для Индекс = 0 По ПоляКандидаты.Количество() - 1 Цикл
                                КандидатПоля = ПоляКандидаты[Индекс];
                                Если НЕ ПустаяСтрока(Условия) Тогда
                                    Условия = Условия + " ИЛИ ";
                                КонецЕсли;
                                Условия = Условия + "Т." + КандидатПоля.field + " = &Цель";
                                Маркеры = Маркеры + " КОГДА Т." + КандидатПоля.field + " = &Цель ТОГДА "
                                    + Формат(Индекс + 1, "ЧГ=0");
                            КонецЦикла;
                            Маркеры = Маркеры + " ИНАЧЕ 0 КОНЕЦ КАК ПолеСовпадения";

                            Запрос1С = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ " + Формат(Осталось + 1, "ЧГ=0")
                                + " " + Поля + ", " + Маркеры + " ИЗ " + ТаблицаКандидатов + " КАК Т ГДЕ " + Условия);
                            Запрос1С.УстановитьПараметр("Цель", Цель);
                            Выборка = Запрос1С.Выполнить().Выбрать();
                            ВПоле = 0;
                            Пока Выборка.Следующий() Цикл
                                Если ВПоле >= Осталось ИЛИ СчетчикМета >= П.limit_per_meta ИЛИ Найденные.Количество() >= П.limit_hits Тогда
                                    Результат.truncated = Истина;
                                    Прервать;
                                КонецЕсли;
                                НомерПоля = Выборка["ПолеСовпадения"];
                                Если НомерПоля < 1 ИЛИ НомерПоля > ПоляКандидаты.Количество() Тогда
                                    Продолжить;
                                КонецЕсли;
                                К = ПоляКандидаты[НомерПоля - 1];
                                Представление = "";
                                Для Каждого Ключ Из Ключи Цикл
                                    Если НЕ ПустаяСтрока(Представление) Тогда
                                        Представление = Представление + "; ";
                                    КонецЕсли;
                                    ЗначениеКлюча = Выборка[Ключ];
                                    Представление = Представление + Ключ + "=" + Строка(ЗначениеКлюча);
                                    Если ЭтоОбъект Тогда
                                        Представление = Представление + " (" + Строка(ЗначениеКлюча.УникальныйИдентификатор()) + ")";
                                    КонецЕсли;
                                КонецЦикла;
                                Найденные.Добавить(Новый Структура("found_in_meta,found_in_object,path,match_kind", ПолноеИмя, Представление, К.path, К.match_kind));
                                ВПоле = ВПоле + 1;
                                СчетчикМета = СчетчикМета + 1;
                            КонецЦикла;
                        Исключение
                            Пропуски.Добавить(Новый Структура("name,reason", ТаблицаКандидатов, "Запрос недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
                        КонецПопытки;
                    КонецЦикла;
                Исключение
                    Пропуски.Добавить(Новый Структура("name,reason", ПолноеИмя, "Обход метаданных недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
                КонецПопытки;
            КонецЦикла;
        КонецЦикла;
        Возврат ОтветJSON(Результат);
    Исключение
        Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции

// ── Права метаданных (без анализа RLS) ────────────────────────

Функция ПраваМетаданныхPOST(Запрос)
    Если НЕ МетодДоступен("ПраваМетаданных", "POST") Тогда
        Возврат ОтветОшибка(403, "Нет права использования метода");
    КонецЕсли;
    Попытка
        П = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
        Части = СтрРазделить(П.metadata_object, ".");
        Если Части.Количество() <> 2 Тогда
            Возврат ОтветОшибка(400, "Ожидается Тип.ИмяОбъекта");
        КонецЕсли;
        ПроверитьИмяМетаданных(Части[0]);
        ПроверитьИмяМетаданных(Части[1]);
        Мета = Метаданные.НайтиПоПолномуИмени(П.metadata_object);
        Если Мета = Неопределено Тогда
            Возврат ОтветОшибка(400, "Объект метаданных не найден");
        КонецЕсли;
        Если ТипЗнч(П.rights) <> Тип("Массив") ИЛИ ТипЗнч(П.roles) <> Тип("Массив") Тогда
            Возврат ОтветОшибка(400, "rights и roles должны быть массивами");
        КонецЕсли;
        Если П.rights.Количество() = 0 Тогда
            ТиповыеПрава = "Чтение,Просмотр";
            Если Части[0] = "Справочник" ИЛИ Части[0] = "Документ" Тогда
                ТиповыеПрава = ТиповыеПрава + ",Добавление,Изменение,Удаление";
            КонецЕсли;
            Если Части[0] = "Документ" Тогда
                ТиповыеПрава = ТиповыеПрава + ",Проведение,ОтменаПроведения";
            КонецЕсли;
            П.rights = СтрРазделить(ТиповыеПрава, ",");
        КонецЕсли;
        Строки = Новый Массив;
        Нотатки = Новый Массив;
        Нотатки.Добавить("Показаны права объекта; ограничения RLS не анализируются");
        Если Части[0] <> "Справочник" И Части[0] <> "Документ"
            И Части[0] <> "РегистрСведений" И Части[0] <> "РегистрНакопления"
            И Части[0] <> "РегистрБухгалтерии" И Части[0] <> "РегистрРасчета" Тогда
            Нотатки.Добавить("Тип использует универсальный список прав; недоступные проверки отмечаются отдельно");
        КонецЕсли;
        Если НЕ ПустаяСтрока(П.user_name) ИЛИ П.roles.Количество() > 0 Тогда
            Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
                Возврат ОтветОшибка(403, "Проверка другого пользователя/ролей требует административных прав");
            КонецЕсли;
        КонецЕсли;
        Если НЕ ПустаяСтрока(П.user_name) Тогда
            Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(П.user_name);
            Если Пользователь = Неопределено Тогда
                Возврат ОтветОшибка(400, "Пользователь не найден");
            КонецЕсли;
        КонецЕсли;
        Для Каждого ИмяРоли Из П.roles Цикл
            Если Метаданные.Роли.Найти(ИмяРоли) = Неопределено Тогда
                Имена = Новый Массив;
                Для Каждого Роль Из Метаданные.Роли Цикл
                    Имена.Добавить(Роль.Имя);
                КонецЦикла;
                Возврат ОтветОшибка(400, "Неизвестная роль. Доступны: " + СтрСоединить(Имена, ", "));
            КонецЕсли;
        КонецЦикла;
        Для Каждого Право Из П.rights Цикл
            Если П.roles.Количество() > 0 Тогда
                Для Каждого ИмяРоли Из П.roles Цикл
                    Попытка
                        Доступ = ПравоДоступа(Право, Мета, Метаданные.Роли.Найти(ИмяРоли));
                        Строки.Добавить(Новый Структура("right,subject,allowed", Право, ИмяРоли, Доступ));
                    Исключение
                        Строки.Добавить(Новый Структура("right,subject,allowed", Право, ИмяРоли, Неопределено));
                        Нотатки.Добавить("Проверка права " + Право + " за ролью недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
                    КонецПопытки;
                КонецЦикла;
            Иначе
                Попытка
                    Если ПустаяСтрока(П.user_name) Тогда
                        Доступ = ПравоДоступа(Право, Мета);
                        Субъект = "Текущий HTTP-пользователь";
                    Иначе
                        Доступ = ПравоДоступа(Право, Мета, Пользователь);
                        Субъект = П.user_name;
                    КонецЕсли;
                    Строки.Добавить(Новый Структура("right,subject,allowed", Право, Субъект, Доступ));
                Исключение
                    Строки.Добавить(Новый Структура("right,subject,allowed", Право, П.user_name, Неопределено));
                    Нотатки.Добавить("Проверка права " + Право + " недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
                КонецПопытки;
            КонецЕсли;
        КонецЦикла;
        Если НЕ ПустаяСтрока(П.user_name) И П.roles.Количество() > 0 Тогда
            Нотатки.Добавить("roles задаёт отдельную проверку ролей; это не эффективные права указанного пользователя");
        КонецЕсли;
        Возврат ОтветJSON(Новый Структура("rights,notes", Строки, Нотатки));
    Исключение
        Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции
