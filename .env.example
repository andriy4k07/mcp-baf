# Скопіюйте в .env (docker compose читає його автоматично). Повний перелік — docs/configuration.md.

# --- 1С ---
mcp_baf_BASE_URL=http://host.docker.internal:8080/hs/mcp-baf
mcp_baf_USER=
mcp_baf_PASSWORD=
# Пароль із файлу (Docker secret) замість mcp_baf_PASSWORD; одночасно двох не задавати
# mcp_baf_PASSWORD_FILE=/run/secrets/baf_password

# --- Транспорт ---
# https (типово в образі) | http (без TLS: лише разом із mcp_baf_ALLOW_INSECURE_HTTP=1)
mcp_baf_TRANSPORT=https
# mcp_baf_ALLOW_INSECURE_HTTP=1
# Адреса прив'язки HTTP-сервера (типово 127.0.0.1; у образі 0.0.0.0)
# mcp_baf_HTTP_HOST=0.0.0.0
# Порт прив'язки HTTP-сервера (типово 8001)
# mcp_baf_HTTP_PORT=8001
# Bearer-токен, обов'язковий: python -c "import secrets; print(secrets.token_urlsafe(32))"
mcp_baf_HTTP_TOKEN=
# Той самий токен із файлу (Docker secret); одночасно з mcp_baf_HTTP_TOKEN не задавати
# mcp_baf_HTTP_TOKEN_FILE=/run/secrets/mcp_token
# Свій сертифікат (шляхи в контейнері, файли змонтуйте). Порожньо — згенерований CA.
# mcp_baf_TLS_CERT=/certs/fullchain.pem
# mcp_baf_TLS_KEY=/certs/privkey.pem
# Дозволені Host (і додаткові SAN згенерованого сертифіката).
# Задане значення вмикає захист від DNS-rebinding. Порожньо: захист лише при
# loopback-bind, у контейнері (0.0.0.0) він вимкнений.
# mcp_baf_HTTP_ALLOWED_HOSTS=mcp-baf:8001,mcp.example.lan:8001
# Вимкнути захист від DNS-rebinding (не рекомендується, пише попередження):
# mcp_baf_HTTP_DISABLE_DNS_REBINDING=1

# --- Таймаути 1С (секунди) ---
# read (очікування відповіді) — 300; connect короткий, щоб недоступна 1С
# падала за секунди, а не за 5 хвилин.
# mcp_baf_REQUEST_TIMEOUT=300
# Дедлайн усього запиту (усі повтори разом) — 600; read-таймаут діє на чанк,
# тож без дедлайна «капаючий» потік жив би нескінченно.
# mcp_baf_REQUEST_DEADLINE=600
# mcp_baf_CONNECT_TIMEOUT=10
# mcp_baf_WRITE_TIMEOUT=60
# mcp_baf_POOL_TIMEOUT=10
# Максимум одночасних з'єднань (= сеансів 1С); решта чекає слот до POOL_TIMEOUT.
# mcp_baf_MAX_CONNECTIONS=8

# --- Повтори (помилки з'єднання/пулу, 502/503/504; read-таймаут і 500 — ні) ---
# Лише для ідемпотентних запитів (сервіс read-only). 0 — вимкнено.
# mcp_baf_RETRY_ATTEMPTS=2
# mcp_baf_RETRY_BACKOFF=0.5
# Повторювати й пишучі запити (за замовчуванням — ні):
# mcp_baf_RETRY_NON_IDEMPOTENT=1
# Максимальний розмір відповіді 1С, MiB (типово 128)
# mcp_baf_MAX_RESPONSE_SIZE=128

# --- Вивантаження конфігурації (розкоментуйте том у docker-compose.yaml) ---
# mcp_baf_DUMP_DIR=/dump
# Каталог .hbk-файлів довідки платформи (шлях у контейнері, файли змонтуйте); порожньо — інструменти довідки вимкнені
# mcp_baf_HELP_DIR=/help

# --- Персональні дані та кеш ---
# Маскувати ПІБ/телефон/email тощо в результатах інструментів (1, true, yes, on)
# mcp_baf_MASK_PII=1
# Каталог для audit.log, server.log і кешу індексу (типово — платформенний кеш)
# mcp_baf_CACHE_DIR=/data
# Ротація audit.log: розмір у MiB (типово 50) і кількість архівів (типово 20)
# mcp_baf_AUDIT_MAX_SIZE=50
# mcp_baf_AUDIT_ARCHIVES=20
# Вимкнути прогрес у stderr (лише значення 1)
# mcp_baf_NO_TTY=1

# --- Встановлення розширення (--install; сервер їх не читає) ---
# Пароль бази для DESIGNER; задавайте лише один з двох варіантів
# mcp_baf_DB_PASSWORD=
# mcp_baf_DB_PASSWORD_FILE=/run/secrets/db_password
# Таймаут одного запуску DESIGNER, секунди (типово 3600)
# mcp_baf_DESIGNER_TIMEOUT=3600

# --- Публікація порту на хості (лише compose) ---
# MCP_BAF_BIND=0.0.0.0
# MCP_BAF_PUBLISHED_PORT=8001
