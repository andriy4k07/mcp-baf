# Скопіюйте в .env (docker compose читає його автоматично). Повний перелік — docs/configuration.md.

# --- 1С ---
mcp_baf_BASE_URL=http://host.docker.internal:8080/hs/mcp-baf
mcp_baf_USER=
mcp_baf_PASSWORD=

# --- Транспорт ---
# https (типово в образі) | http (без TLS: лише разом із mcp_baf_ALLOW_INSECURE_HTTP=1)
mcp_baf_TRANSPORT=https
# mcp_baf_ALLOW_INSECURE_HTTP=1
# Bearer-токен, обов'язковий: python -c "import secrets; print(secrets.token_urlsafe(32))"
mcp_baf_HTTP_TOKEN=
# Свій сертифікат (шляхи в контейнері, файли змонтуйте). Порожньо — згенерований CA.
# mcp_baf_TLS_CERT=/certs/fullchain.pem
# mcp_baf_TLS_KEY=/certs/privkey.pem
# Дозволені Host (і додаткові SAN згенерованого сертифіката).
# Порожньо — типовий набір: localhost, 127.0.0.1, [::1], hostname контейнера
# (mcp-baf) на будь-якому порту. Задавайте, щоб додати/замінити хости.
# mcp_baf_HTTP_ALLOWED_HOSTS=mcp-baf:8001,mcp.example.lan:8001
# Вимкнути захист від DNS-rebinding (не рекомендується, пише попередження):
# mcp_baf_HTTP_DISABLE_DNS_REBINDING=1

# --- Таймаути 1С (секунди) ---
# read (очікування відповіді) — 300; connect короткий, щоб недоступна 1С
# падала за секунди, а не за 5 хвилин.
# mcp_baf_REQUEST_TIMEOUT=300
# mcp_baf_CONNECT_TIMEOUT=10
# mcp_baf_WRITE_TIMEOUT=60
# mcp_baf_POOL_TIMEOUT=10

# --- Повтори на транзиентні помилки (транспорт/5xx) ---
# Лише для ідемпотентних запитів (сервіс read-only). 0 — вимкнено.
# mcp_baf_RETRY_ATTEMPTS=2
# mcp_baf_RETRY_BACKOFF=0.5
# Повторювати й пишучі запити (за замовчуванням — ні):
# mcp_baf_RETRY_NON_IDEMPOTENT=1

# --- Вивантаження конфігурації (розкоментуйте том у docker-compose.yaml) ---
# mcp_baf_DUMP_DIR=/dump

# --- Публікація порту на хості (лише compose) ---
# MCP_BAF_BIND=0.0.0.0
# MCP_BAF_PUBLISHED_PORT=8001
